<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Voyageur" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryVariant">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorSecondaryVariant">@color/orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/navy_dark</item>
        <item name="android:windowBackground">@color/off_white</item>
    </style>

    <style name="Theme.Voyageur.Splash">
        <item name="android:windowBackground">@drawable/bg_gradient_splash</item>
        <item name="android:statusBarColor">@color/navy_dark</item>
    </style>

    <style name="ItineraryItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:drawableStart">@drawable/ic_activity_check</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
